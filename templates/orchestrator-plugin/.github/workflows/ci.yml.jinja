# Per-target matrix CI for {{ plugin_full_name }}.
#
# Generated from livespec/templates/orchestrator-plugin/.github/workflows/
# ci.yml.jinja at copier-copy time; re-sync via `copier update --vcs-ref=master` when
# livespec publishes a new release.
#
# Authority: livespec/SPECIFICATION/contracts.md
#   §"Pre-commit step ordering" + non-functional-requirements.md
#   §"CI as a merge gate (branch protection)": every gating check runs on
#   `pull_request` exactly as on `push` to master — the PR gate is identical
#   to the master gate (PR gate ≡ master gate). There is NO change-detection
#   gate: a doc-only PR runs the full Python-code matrix like any other push,
#   so a PR can never be greener than master will be after it merges.
#
# Authority: livespec/SPECIFICATION/non-functional-requirements.md
#   §"Toolchain pins" — direct tool invocations (ruff, pyright,
#   pytest, python3) in `run:` lines are forbidden; every step
#   delegates to `just <target>`.
#
# Starter scaffold: the Python-code matrix carries only the tool-
# backed checks (lint, format, types, coverage). The metadata matrix
# is empty. As {{ plugin_full_name }} populates dev-tooling/checks/
# scripts, add the corresponding `check-<slug>` targets to the
# appropriate matrix and to branch protection's required-status-
# checks list.

name: CI

# uv occasionally fails when the PyPI file CDN (files.pythonhosted.org)
# drops a wheel download mid-stream ("broken pipe"). UV_HTTP_RETRIES
# makes uv retry the fetch in-process instead of failing the job.
# Combined with the ~/.cache/uv actions/cache step (keyed on uv.lock)
# every uv-sync job uses below, an unchanged lock installs from cache
# and never contacts PyPI at all.
env:
  UV_HTTP_RETRIES: "5"

on:
  pull_request:
  push:
    branches: [master]
  merge_group:

jobs:
  check-python:
    name: ${{ '{{' }} matrix.target {{ '}}' }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        target:
          - check-lint
          - check-format
          - check-types
          - check-coverage
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install pinned binaries via mise
        uses: jdx/mise-action@v2

      - name: Restore uv download cache
        uses: actions/cache@v4
        with:
          path: ~/.cache/uv
          key: uv-${{ '{{' }} runner.os {{ '}}' }}-${{ '{{' }} hashFiles('uv.lock') {{ '}}' }}
          restore-keys: uv-${{ '{{' }} runner.os {{ '}}' }}-

      - name: Install Python dev deps via uv
        run: uv sync --all-groups

      - name: just ${{ '{{' }} matrix.target {{ '}}' }}
        run: just ${{ '{{' }} matrix.target {{ '}}' }}

  # Metadata matrix runs unconditionally to preserve the repo-metadata
  # safety net. Empty in the starter; populate as {{ plugin_full_name }}
  # adds dev-tooling/checks/<slug>.py scripts for
  # claude-md-coverage, heading-coverage, vendor-manifest,
  # no-direct-tool-invocation, check-tools, and similar.
  check-metadata:
    name: metadata-checks
    runs-on: ubuntu-latest
    steps:
      - name: Placeholder
        run: echo "::notice::metadata-checks matrix is empty; populate as dev-tooling/checks/ scripts land"

  # Closed-loop CI telemetry: export this run's per-job timings to Honeycomb
  # (dataset github-ci) and FAIL if Honeycomb does not accept them, so a broken
  # telemetry pipeline reddens master CI instead of dying silently. Master/
  # merge_group only (PRs untouched, no added latency). REQUIRES the repo secret
  # HONEYCOMB_GITHUB_CI_INGEST_KEY_LIVESPEC (the livespec fleet write-only
  # ingest key). A freshly generated {{ plugin_full_name }} fails this job on its
  # first master run until that secret is added — add it, or delete this job if
  # {{ plugin_full_name }} does not send CI telemetry to Honeycomb.
  export-telemetry:
    name: export-telemetry
    needs: [check-python, check-metadata]
    if: ${{ '{{' }} !cancelled() && (github.event_name == 'push' || github.event_name == 'merge_group') {{ '}}' }}
    runs-on: ubuntu-latest
    permissions:
      actions: read
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Export CI run telemetry to Honeycomb (closed-loop verified)
        env:
          GH_TOKEN: ${{ '{{' }} secrets.GITHUB_TOKEN {{ '}}' }}
          REPO: ${{ '{{' }} github.repository {{ '}}' }}
          RUN_ID: ${{ '{{' }} github.run_id {{ '}}' }}
          HONEYCOMB_GITHUB_CI_INGEST_KEY_LIVESPEC: ${{ '{{' }} secrets.HONEYCOMB_GITHUB_CI_INGEST_KEY_LIVESPEC {{ '}}' }}
        run: bash .github/scripts/export-ci-telemetry.sh
